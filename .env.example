# APP_URL: Public URL of the frontend app.
APP_URL="https://s-hub-ba.github.io/s-hub-app/"

# VITE_API_BASE_URL: Public URL of the backend API server (no trailing slash).
# Keep empty for local same-origin development.
VITE_API_BASE_URL="https://your-backend-domain.com"

# VITE_FIREBASE_VAPID_KEY: Firebase Web Push public key used for browser FCM token registration.
VITE_FIREBASE_VAPID_KEY="BANoMmpeuOTAK5zhi4NxLvy7a7cJrvLQ0Bxu_CnT0abaD2yW4ejqSLGdtEVp4lQlBaNjtVnqU_Vd4VW0jugAa0o"

# VITE_BASE_PATH: Base path used by Vite when deployed under a subpath.
VITE_BASE_PATH="/s-hub-app/"

# VITE_USE_HASH_ROUTER: Use hash routing for static hosts like GitHub Pages.
VITE_USE_HASH_ROUTER="true"

# FIREBASE_SERVICE_ACCOUNT_KEY: JSON string for backend Firebase Admin auth.
# Required when deploying the backend outside Google Cloud.
FIREBASE_SERVICE_ACCOUNT_KEY="{\"type\":\"service_account\",\"project_id\":\"...\"}"

# Optional PayPal backend settings for production billing flows.
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_PLAN_STARTER=""
PAYPAL_PLAN_PROFESSIONAL=""
PAYPAL_PLAN_ENTERPRISE=""

# Supabase Configuration
# Get these from your Supabase Project Settings -> API
VITE_SUPABASE_URL="your-project-url"
VITE_SUPABASE_ANON_KEY="your-anon-key"
